# -----------------------------------------------------------------
# Solvd environment variables
#
# Copy this file to web/.env.local and fill in the real values:
#
#     cp .env.example web/.env.local
#
# Where to find these: Supabase dashboard -> Project Settings -> API
#
# WHY web/ AND NOT THE REPO ROOT: Next.js only auto-loads .env.local
# from its own project directory, which is web/. Putting it at the repo
# root means the app silently sees no keys. The seed script in scripts/
# reads web/.env.local too, so one file still covers both.
#
# IMPORTANT: .env.local is gitignored. Never commit real keys.
# -----------------------------------------------------------------

# Your project's URL. Looks like https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key. Safe to expose in the browser — it is
# restricted by the Row Level Security policies in
# supabase/migrations/0001_init.sql (public read only).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional locally, REQUIRED in production. Your real origin, no trailing slash.
# Canonical <link> tags and JSON-LD @id values are built from this, so leaving it
# unset on Vercel would publish links pointing at localhost.
NEXT_PUBLIC_SITE_URL=

# The "service_role" / "secret" key. BYPASSES Row Level Security.
# Used ONLY by scripts/seed.mjs, never by the web app, never in the
# browser. Treat it like a password. Do not add it to Vercel unless
# you need it there.
SUPABASE_SERVICE_ROLE_KEY=
